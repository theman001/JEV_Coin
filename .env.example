# 이 파일을 .env 로 복사해서 값을 채우세요.   cp .env.example .env
# (.env 는 .gitignore 에 들어 있어 git 에 올라가지 않습니다)
# OMV: 컴포즈 플러그인의 "환경 변수(.env)" 칸에 채운 내용을 그대로 붙여넣으면 됩니다.
# 주의: 값 뒤에 주석을 붙이지 마세요 (줄 전체가 주석일 때만 # 사용).

# ===== 필수 =====

# Jev(TypeSafe) API 키. https://console.typesafe.ai 에서 발급.
# 비워두면 Jev 대신 테스트용 규칙 판단(FakeJudge)으로 동작합니다 — 웹 화면 상단에 경고 표시됨.
TYPESAFE_API_KEY=

# 웹 UI 로그인 비밀번호. 웹에서 매매 시작/중지를 제어하므로 반드시 설정 (비어 있으면 컨테이너가 시작하지 않음).
# 영문/숫자 권장. 로그인 아이디는 아래 WEB_USER.
WEB_PASSWORD=

# ===== 선택 (기본값 그대로 써도 됨) =====

WEB_USER=admin

# 호스트에서 접속할 포트 → http://<보드IP>:8787  (OMV 웹 GUI 는 80/443 이므로 겹치지 않음)
WEB_PORT=8787

# 웹에서 선택할 수 있는 코인 목록 (쉼표 구분, ccxt 심볼). 첫 번째가 기본 코인.
# 참고: BTC/ETH 1~5분봉은 변동폭이 왕복 수수료보다 작아 진입 게이트에 자주 막힙니다 (CLAUDE.md 참고).
SYMBOLS=SOL/USDT,ETH/USDT,BTC/USDT,XRP/USDT,DOGE/USDT

# 캔들 주기 (1m, 5m, 15m ...). 캔들이 마감될 때마다 Jev 를 1회 호출합니다.
TIMEFRAME=5m

# 시세를 가져올 거래소 (ccxt id). 지역 제한으로 binance 가 막히면 bybit, okx 등으로 변경.
EXCHANGE=binance

# 손절 감시·지표 갱신 주기(초)
POLL_SECONDS=10

# 모의계좌 시작 자본 (USDT). 볼륨에 저장된 계좌(state.json)가 있으면 그 값이 우선 → 바꾸려면 볼륨을 지워야 함.
PAPER_EQUITY=100

# ===== 추세추종 봇 jev-trend (STRATEGY_RESEARCH.md §14, Jev 없이 규칙만) =====
# 규칙(4h SMA 20/50)·코인(BTC/ETH/SOL/XRP/DOGE KRW)·거래소(Upbit)는 사전 고정 설계라 compose 에 고정돼 있습니다. 여기서는 아래 둘만 바꿀 수 있습니다.

# 접속 포트 → http://<보드IP>:8788  (로그인은 위의 WEB_USER / WEB_PASSWORD 와 같음)
TREND_PORT=8788

# 모의 시작 자본 (원, 5코인에 균등 배분). 볼륨에 저장된 상태(trend_state.json)가 있으면 그 값이 우선 → 바꾸려면 볼륨을 지워야 함.
TREND_EQUITY=1000000

# 컨테이너 로그 시각 시간대 (웹 화면은 브라우저 시간대를 따름)
TZ=Asia/Seoul
